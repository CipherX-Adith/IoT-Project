# ===================================================
# SunShield Environment Configuration (.env.example)
# ===================================================

# Frontend Firebase Realtime Database Configuration (Vite)
# Obtain these from: Firebase Console > Project Settings > Your Apps > Web App (</>)
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere123456789
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Backend Serverless Configuration (Vercel API Routes)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
# Optional: Firebase Database Secret or Service Account Token if database rules require auth
FIREBASE_DATABASE_SECRET=

# Public Health Alert Push Notifications (ntfy.sh topic name)
NTFY_TOPIC=sunshield-alerts-live
